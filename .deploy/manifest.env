# Split frontend/API deployment on the shared infra server.
APP_NAME=jkbk-datahub
TYPE=split
IMAGE_REPO=ghcr.io/asheryram/jj

WEB_CONTEXT=./frontend
WEB_DOCKERFILE=./frontend/Dockerfile.infra
WEB_PORT=80
WEB_REQUIRED_ENV=""

API_CONTEXT=./backend
API_DOCKERFILE=./backend/Dockerfile.infra
API_PORT=3001
API_REQUIRED_ENV="DATABASE_URL DIRECT_URL ANALYTICS_DATABASE_URL JWT_SECRET SUPERADMIN_EMAIL PAYSTACK_SECRET_KEY"

# The API Docker entrypoint runs npm run start:prod, which applies database
# migrations and constraints before serving. Do not run release a second time.
MIGRATE_CMD=''

PREVIEW_AUTH=true
API_PREVIEW_AUTH=false
MAX_PREVIEWS_PER_APP=3
