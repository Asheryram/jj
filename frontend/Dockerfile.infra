FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
# VITE_API_URL is fixed into the bundle at build time, so build with a placeholder; the container swaps in the real
# address (the VITE_API_URL variable from the platform) when it starts. One image then serves every environment.
RUN VITE_API_URL=__INFRA_VITE_API_URL__ npm run build \
  && sed -i 's#<head>#<head><script src="/env.js"></script>#' dist/index.html

FROM nginx:1.27-alpine
COPY deploy-spa/nginx.conf /etc/nginx/conf.d/default.conf
COPY deploy-spa/40-runtime-env.sh /docker-entrypoint.d/40-runtime-env.sh
RUN chmod 755 /docker-entrypoint.d/40-runtime-env.sh
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
HEALTHCHECK --interval=15s --timeout=3s --retries=3 \
  CMD wget -qO- http://127.0.0.1/healthz >/dev/null || exit 1
