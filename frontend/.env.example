# Copy to .env.local to point the app at an API.
#
# VITE_API_URL is the base address of the NestJS API, and it must end in /api.
# Request paths in src/lib/api.ts are written without a prefix ('/auth/login',
# '/catalogue'), because the API mounts everything under `api` via
# setGlobalPrefix('api'). Leave the suffix off and the site loads perfectly while
# every request 404s.
#
# Unset, it falls back to a same-origin '/api'. That is the right value when the
# SPA and the API sit behind one host, and it is what the Vite dev proxy serves.
# There is no mock and no demo mode, every figure on screen comes from the API,
# so with nothing listening the app correctly reports that it cannot reach the
# shop.
#
# This is read at BUILD time. Vite inlines it when it compiles, so on Vercel a
# change here does nothing until you redeploy.
VITE_API_URL=http://localhost:3001/api

# Who is behind the site. Shown on the Contact page, in the footer and on the
# legal pages. Anything left empty is simply not shown, nothing is invented, so
# fill in only what is true. VITE_BUSINESS_EMAIL also powers the "Send request"
# buttons on the data requests page. Build time, like the rest.
VITE_BUSINESS_LEGAL_NAME=
VITE_BUSINESS_REGISTRATION_NUMBER=
VITE_BUSINESS_ADDRESS=
VITE_BUSINESS_EMAIL=
VITE_BUSINESS_PHONE=
# Month shown as "Last reviewed" on the legal pages. Update when they are reviewed.
VITE_LEGAL_UPDATED=
