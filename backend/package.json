{
  "name": "backend",
  "version": "0.0.1",
  "description": "JamesDataConsult API — NestJS + Prisma + PostgreSQL",
  "private": true,
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "db:wait": "node scripts/wait-for-db.mjs",
    "prisma:generate": "prisma generate",
    "migrate": "prisma migrate dev --name init",
    "migrate:deploy": "prisma migrate deploy",
    "constraints": "docker exec jdc-postgres psql -v ON_ERROR_STOP=1 -U jdc -d jdc -q -f /scripts/constraints.sql",
    "seed": "tsx prisma/seed.ts",
    "seed:history": "tsx prisma/seed.ts --with-history",
    "setup": "npm run db:up && npm run db:wait && npm run migrate && npm run constraints && npm run seed",
    "start": "nest start",
    "dev": "nest start --watch",
    "build": "nest build",
    "start:prod": "npm run release && node dist/main.js",
    "audit:money": "tsx scripts/money-audit.ts",
    "ledger:backfill": "tsx scripts/backfill-ledger.ts",
    "catalogue:purge": "tsx scripts/purge-unsupplied.ts",
    "constraints:prod": "prisma db execute --file scripts/constraints.sql --schema prisma/schema.prisma",
    "release": "prisma migrate deploy && npm run constraints:prod",
    "db:backup": "node scripts/backup.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/serve-static": "^5.0.5",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "helmet": "^8.3.0",
    "nodemailer": "^9.0.5",
    "prisma": "^6.19.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.9",
    "@types/express": "^5.0.1",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
