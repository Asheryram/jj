DATABASE_URL="postgresql://jdc:jdc_dev_password@localhost:5433/jdc?schema=public"
# Prisma Migrate needs its own, un-pooled connection (see the comment on
# `datasource db` in schema.prisma), locally there's no pooler at all, so
# this is just the same URL as above. In production (Neon) it must be the
# DIRECT connection string, not the pooled one DATABASE_URL uses there.
DIRECT_URL="postgresql://jdc:jdc_dev_password@localhost:5433/jdc?schema=public"

# A separate database for the analytics warehouse (see prisma-analytics/schema.prisma),
# never the same one as DATABASE_URL. Locally, a second database on the same
# Postgres server: `CREATE DATABASE analytics_warehouse;`, then this connection
# string just swaps the database name.
ANALYTICS_DATABASE_URL="postgresql://jdc:jdc_dev_password@localhost:5433/analytics_warehouse?schema=public"

PORT=3001
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

JWT_SECRET="change-me"
JWT_EXPIRES_IN="12h"

SEED_PASSWORD="demo1234"

FULFILMENT_DELAY_MS=2600

# Leave empty to run the simulated provider against the seeded supplier
# catalogue. Set them to switch to the live integration.
# Real purchases. false (or unset) = simulated. Requires a restart to change.
DATAHUB_LIVE=false

DATAHUB_API_KEY=
DATAHUB_BASE_URL=

# GMPL (getmorepaylessdatahouse.net), the second supplier. Same on/off shape
# as DataHub above, its own independent switch: one can be live while the
# other is simulated. GMPL_SECRET is the agent's x-api-key (ak_live_.../ak_test_...).
GMPL_LIVE=false
GMPL_SECRET=
GMPL_BASE_URL=
# The `whsec_...` signing secret from registering a webhook subscription
# (POST /agent/webhooks, a one-off script, not app code). Needed to verify
# their X-Telecom-Signature header.
GMPL_WEBHOOK_SECRET=

PAYSTACK_SECRET_KEY=

# ── Paystack ────────────────────────────────────────────────────────────────
# Secret key from the Paystack dashboard. With it set, Mobile Money checkout and
# wallet top-ups collect real money; without it both are simulated in-process.
PAYSTACK_SECRET_KEY=

# Where Paystack sends the customer back to after paying. Must be the address
# the browser can reach, an ngrok URL during testing, the real domain in
# production. Defaults to http://localhost:5173.
PUBLIC_APP_URL=

# Register this with Paystack as the webhook URL:
#   <api origin>/api/payments/paystack/webhook
# It is HMAC-verified with the secret key above, so it needs no secret of its own.

# ── Custom domains ──────────────────────────────────────────────────────────
# The wildcard root an agent's free subdomain is composed against, e.g.
# "jkbkdatahub.com" makes "kwame" resolve at kwame.jkbkdatahub.com. Requires a
# wildcard domain (*.jkbkdatahub.com) added in the frontend's Vercel project
# first, this only makes the backend accept and resolve the request, it does
# not provision DNS or a certificate itself. Leave empty to disable requesting
# a subdomain at all (an agent's own BYO domain still works either way).
PLATFORM_ROOT_DOMAIN=

# ── Platform access ─────────────────────────────────────────────────────────
# Who runs the platform, as opposed to the business on it. On boot this address
# is made a superadmin; if it has no password yet, a one-time setup link is
# printed to the server log. Follow it once to choose your own password.
#
# The superadmin then creates the admin (the business owner) from
# Platform > Team, and hands them their own one-time link. No password is ever
# seeded, emailed, or known by anybody but its owner.
#
# Required in production, the app refuses to start without it.
SUPERADMIN_EMAIL=

# ── SMS (BMS Africa, https://developer.bms.africa/) ─────────────────────────
# Texts buyers when an order is delivered (with the voucher for a checker) or
# fails, when a refund reaches them, and agents when a payout is sent. Every
# text is sent in the background and any failure is only logged: an SMS can
# never delay, block or undo an order, refund or payout. Leave either value
# empty and nothing is sent at all.
#
# API key: app.bms.africa > Settings > Developer.
SMS_API_KEY=
# Sender name shown on the phone, at most 11 characters. It must be registered
# and approved in your BMS account first, or every message is refused.
SMS_SENDER_ID=
# Set to false to stop all texts without removing the key.
SMS_ENABLED=true

# ── Email (Resend) ──────────────────────────────────────────────────────────
# Sends account setup and password reset links, and is tried first when both
# this and SMTP below are configured, no daily send quota, and not tied to
# one person's mailbox. Without a key the app falls back to SMTP if that is
# configured, or logs the message as NOT SENT, so a link is never silently
# lost either way.
RESEND_API_KEY=

# Who mail comes from over Resend. Must be an address on a domain you have
# verified in Resend, e.g. "JamesDataConsult <support@jamesdataconsult.com>".
#
# Avoid a "no-reply@" address, deliverability tools (and mailbox providers)
# read it as a signal the sender doesn't want feedback, which hurts trust and
# spam scoring. Use one that could plausibly receive a reply, even if nobody
# is watching it closely.
#
# IMPORTANT: left empty, this falls back to Resend's shared sender
# (onboarding@resend.dev), which ONLY delivers to the address that owns the
# Resend account. Everything looks like it worked and nobody else receives
# anything. Verify a domain before anyone but you is expected to get mail.
MAIL_FROM=

# ── Email: SMTP (Gmail or any provider) ─────────────────────────────────────
# The fallback, tried when Resend is not configured or a send through it
# fails, container platforms routinely block outbound SMTP, so this is worth
# having even once Resend is primary. Set on its own it works standalone too.
#
# Gmail needs an App Password, not the account password: turn on 2-Step
# Verification, then create one at myaccount.google.com/apppasswords.
# Roughly 500 messages a day on a free account.
SMTP_USER=
SMTP_PASS=
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=465

# ── In-app help assistant (agents, admin, superadmin) ───────────────────────
# Powers "Ask for help", plain-language answers grounded in the caller's own
# real account or platform data, never able to take an action on anyone's
# behalf. Get a free key at console.groq.com/keys, no card needed, and no
# daily cap the way some other providers' free tiers have. Left empty, the
# feature replies that it isn't set up yet rather than erroring.
GROQ_API_KEY=
