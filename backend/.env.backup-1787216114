# Every seeded account shares this password so testing stays one keystroke.
SEED_PASSWORD="demo1234"

# ── Provider stand-in ───────────────────────────────────────────────────────
# No DataHub GH or Paystack credentials yet, so fulfilment is simulated
# in-process against the seeded `supplier_products` table.
#
# It is DETERMINISTIC on purpose. This build is going to real people for
# acceptance testing, and a random failure rate would have testers filing bugs
# against dice rolls. An order fails only when there is a reason it should:
#   · the provider SKU is marked unavailable  → out of stock
#   · the admin has flipped `simulateFailure`  → forced, for testing the refund
#
# How long the provider takes to confirm. Real DataHub GH is a few seconds.
FULFILMENT_DELAY_MS=2600

# Set to a real key to switch the adapter from simulated to live. Left empty,
# every dispatch is written to supplier_dispatches with simulated = true.
# THE master switch for real purchases. false (or unset) = simulated, and no
# money moves whatever else is configured.
#
# An environment variable rather than an admin toggle on purpose: going live
# spends real money on every order, so it should take a deliberate change and a
# restart — not a click, and not something a compromised admin session can do.
DATAHUB_LIVE=true
DATAHUB_API_KEY=sk_9ff6a12f22b4e4cc0f4b4abf33ea23f1b1b1f4865b22cab6
DATAHUB_BASE_URL=https://app.datahubgh.com/api

# Same story for Paystack: a top-up is credited directly instead of going
# through an initialise → webhook round trip.
# The secret path segment for DataHub's callback. Their webhook carries no
# signature, so this unguessable URL is what stands between an attacker and the
# ability to mark any order SUCCESSFUL. Register it with them as:
#   https://<your-host>/api/webhooks/datahub/<this value>
DATAHUB_WEBHOOK_SECRET=vlAr7dIFf9JsT5wvdINr72RNN1nnH89uKfwMuPyDgv0

PAYSTACK_SECRET_KEY=sk_live_71eb3ec8c98ea57b2ba15fcd238cfcb8727ef8e0

