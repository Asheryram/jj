// The analytics warehouse, a separate database from the production one.
//
// Everything here is written by EtlService, never by the app itself, and can
// always be rebuilt from the production database by re-running the ETL job.
// That keeps this database disposable and keeps every reporting query off the
// database that is actually taking payments.
//
// The shape is deliberately small: one wide row per order (`FactOrder`) and
// per payout (`FactWithdrawal`), kept forever, plus a few things that can only
// be captured as daily snapshots. The /analytics page aggregates over these
// for whatever date range is asked for, so any range, any comparison and any
// cut (network, provider, agent, hour) comes from the same rows and always
// adds up. At this business's volume that is cheaper and far more flexible
// than a table of pre-computed totals per question.
//
// Money is an integer number of pesewas, matching the main schema. Dates are
// YYYYMMDD integers; Ghana is UTC+0 all year, so a UTC day is the Ghana day.

generator client {
  provider = "prisma-client-js"
  // A distinct output, so this never collides with the main app's generated
  // client at the default node_modules/@prisma/client.
  output   = "../node_modules/@prisma-analytics/client"
}

datasource db {
  provider = "postgresql"
  url      = env("ANALYTICS_DATABASE_URL")
}

model EtlCheckpoint {
  id                Int       @id @default(1)
  /// YYYYMMDD of the last day whose reserve snapshot is final. Null before the first run.
  lastFinalizedDate Int?      @map("last_finalized_date")
  /// `EtlService.FACT_VERSION` the order facts were last fully rebuilt with.
  /// A different value forces a full rebuild, so a change to how a fact is
  /// derived reaches every past order, not only recent ones.
  factVersion       Int?      @map("fact_version")
  /// When the last run finished, shown on the page as "data as of".
  lastRunAt         DateTime? @map("last_run_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@map("etl_checkpoint")
}

/// One row per order ever placed, paid or not.
///
/// Money columns come from the ledger, the settled truth, never from the
/// estimate frozen in `Order.split`. They are all attributed to the day the
/// order was placed (`dateKey`), whenever the ledger entry itself landed, so
/// a range's profit is the profit of the sales made in it. Costs are stored
/// as positive amounts; `profit` is the signed sum of every entry that
/// affects profit, exactly `LedgerService.statement()`'s own arithmetic.
model FactOrder {
  orderId   String   @id @map("order_id")
  reference String
  dateKey   Int      @map("date_key")
  createdAt DateTime @map("created_at")
  hour      Int /// 0-23, Ghana time.
  weekday   Int /// 0 Monday ... 6 Sunday.

  status      String
  paidWith    String  @map("paid_with")
  isPaid      Boolean @map("is_paid") /// Money actually received (Mobile Money paid, or a wallet order).
  isCompleted Boolean @map("is_completed")
  /// Paid for, then failed: the customer is owed their money back.
  isFailedAfterPay Boolean @map("is_failed_after_pay")

  network     String /// 'UNKNOWN' when the order has none (a checker voucher).
  category    String
  productId   String  @map("product_id")
  productName String  @map("product_name")
  /// Who actually supplied it: the provider stamped on its cost, else the
  /// provider of its last dispatch, else of the SKU it was sold against.
  /// Null for an order never sent anywhere (unpaid, or failed before sending).
  provider    String?

  /// 'agent' when sold through an agent's store or link, 'direct' otherwise.
  channel   String
  agentId   String? @map("agent_id")
  agentCode String? @map("agent_code")
  agentName String? @map("agent_name")
  buyerPhone  String  @map("buyer_phone")
  buyerUserId String? @map("buyer_user_id")

  salePrice    Int @map("sale_price")
  revenue      Int @default(0) /// Booked on delivery, so 0 for an undelivered order.
  supplierCost Int @default(0) @map("supplier_cost")
  paystackFee  Int @default(0) @map("paystack_fee")
  agentMargin  Int @default(0) @map("agent_margin")
  /// Refunds, write-offs and overpayments that hit profit, as a signed amount.
  adjustments  Int @default(0)
  profit       Int @default(0)

  paidAt      DateTime? @map("paid_at")
  firstSentAt DateTime? @map("first_sent_at")
  completedAt DateTime? @map("completed_at")
  attempts    Int       @default(0) /// Sends to a provider, retries and reorders included.

  /// Short, normalised reason a paid order failed; null otherwise.
  failureReason String? @map("failure_reason")

  refundAmount    Int?      @map("refund_amount")
  refundStatus    String?   @map("refund_status") /// pending, approved, rejected.
  refundCreatedAt DateTime? @map("refund_created_at")
  /// When the customer actually had the money back (transfer paid, or a wallet refund approved).
  refundSettledAt DateTime? @map("refund_settled_at")

  @@index([dateKey])
  @@index([buyerPhone])
  @@index([agentId])
  @@map("fact_orders")
}

/// One row per agent payout request ever made.
model FactWithdrawal {
  withdrawalId String    @id @map("withdrawal_id")
  dateKey      Int       @map("date_key") /// The day it was requested.
  agentId      String    @map("agent_id")
  agentName    String    @map("agent_name")
  amount       Int
  fee          Int
  status       String
  manual       Boolean /// Sent by hand and recorded with "Paid another way".
  requestedAt  DateTime  @map("requested_at")
  decidedAt    DateTime? @map("decided_at")
  paidAt       DateTime? @map("paid_at")

  @@index([dateKey])
  @@map("fact_withdrawals")
}

/// Every user with a referral code, current state, refreshed every run.
/// There is no status history in production to rebuild a past day from.
model BronzeUser {
  id              String    @id
  snapshotDateKey Int       @map("snapshot_date_key")
  role            String
  status          String
  referralCode    String    @map("referral_code")
  uplineCode      String?   @map("upline_code")
  name            String?
  joinedAt        DateTime  @map("joined_at")
  decidedAt       DateTime? @map("decided_at") /// When an agent application was decided.
  ingestedAt      DateTime  @updatedAt @map("ingested_at")

  @@index([snapshotDateKey])
  @@map("bronze_users")
}

model SilverAgentDim {
  agentId         String   @id @map("agent_id")
  referralCode    String   @map("referral_code")
  name            String
  role            String
  status          String
  uplineCode      String?  @map("upline_code")
  depth           Int
  joinedAt        DateTime @map("joined_at")
  joinedDateKey   Int      @map("joined_date_key")
  snapshotDateKey Int      @map("snapshot_date_key")

  @@map("silver_agent_dim")
}

/// One row per agent application. `joinedAt`/`decidedAt` never change once
/// set, so this lands each application on its real day even when rebuilt.
model SilverApplicationFact {
  userId         String @id @map("user_id")
  appliedDateKey Int    @map("applied_date_key")
  decidedDateKey Int?   @map("decided_date_key")
  outcome        String
  hoursToDecide  Float? @map("hours_to_decide")

  @@map("silver_application_facts")
}

/// Numbers a provider blocked until approved, copied as they stand now.
model BronzeBeneficiaryRequest {
  phone           String
  provider        String    @default("datahub-gh")
  snapshotDateKey Int       @map("snapshot_date_key")
  networkKey      String    @map("network_key")
  attempts        Int
  lastProduct     String?   @map("last_product")
  lastValue       Int?      @map("last_value")
  firstSeenAt     DateTime  @map("first_seen_at")
  approvedAt      DateTime? @map("approved_at")
  ingestedAt      DateTime  @updatedAt @map("ingested_at")

  @@id([phone, provider])
  @@index([snapshotDateKey])
  @@map("bronze_beneficiary_requests")
}

model SilverBeneficiaryFact {
  phone           String
  provider        String  @default("datahub-gh")
  dateKey         Int     @map("date_key") /// The day first seen.
  resolvedDateKey Int?    @map("resolved_date_key") /// The day it was approved.
  networkKey      String  @map("network_key")
  attempts        Int
  lastValue       Int?    @map("last_value")
  resolved        Boolean
  hoursToResolve  Float?  @map("hours_to_resolve")

  @@id([phone, provider])
  @@index([dateKey])
  @@index([resolvedDateKey])
  @@map("silver_beneficiary_facts")
}

/// The Reserve panel's arithmetic as of the end of each day, rebuilt from
/// timestamped production history, so every past day can be recomputed.
model DailySolvencySnapshot {
  date Int @id

  expectedAtPaystack   Int  @map("expected_at_paystack")
  spentOnBundles       Int  @map("spent_on_bundles")
  freeToSpend          Int  @map("free_to_spend")
  owedToAgents         Int  @map("owed_to_agents")
  owedToCustomers      Int  @map("owed_to_customers")
  undeliveredOrders    Int  @map("undelivered_orders")
  queuedPayouts        Int  @map("queued_payouts")
  manualRefundAdvances Int  @map("manual_refund_advances")
  manualPayoutAdvances Int  @map("manual_payout_advances")
  liabilitiesTotal     Int  @map("liabilities_total")
  floatBalance         Int? @map("float_balance")

  computedAt DateTime @default(now()) @map("computed_at")

  @@map("daily_solvency_snapshot")
}

/// Each provider's float once a day. Snapshot only: providers publish no
/// balance history, a reading exists only for the moment one was taken.
model DailyFloatSnapshot {
  date     Int
  provider String @default("datahub-gh")

  balance    Int /// The provider's own last reported balance.
  reference  Int /// The lower of that and what tracked capital says it should hold.
  expected   Int? /// What tracked capital says it should hold; null before any capital was logged.
  level      String
  observedAt DateTime? @map("observed_at")

  computedAt DateTime @default(now()) @map("computed_at")

  @@id([date, provider])
  @@map("daily_float_snapshot")
}
