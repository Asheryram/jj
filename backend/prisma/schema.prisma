// JamesDataConsult — persistence model.
//
// Money is ALWAYS an integer number of pesewas, never a float and never
// Decimal-with-scale-2 pretending to be money. GHS 12.50 is 1250. This mirrors
// the `Pesewas` type in the frontend's data/types.ts, and it is the reason every
// amount below is `Int`.
//
// CHECK constraints that the schema language cannot express (balance >= 0,
// resale_price >= floor, the split-balances invariant) live in
// scripts/constraints.sql and are applied by `npm run setup`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  customer
  agent
  admin
  /// The person who runs the platform itself, as opposed to the business on it.
  ///
  /// Exists so nobody has to be handed a password. A superadmin creates the admin
  /// account and passes on a one-time setup link; the admin chooses their own
  /// password and the superadmin never learns it. Before this, the only way an
  /// admin existed was the seed creating one with a password published in
  /// .env.example — fine on a laptop, and not something to put in production.
  ///
  /// A superadmin passes every `admin` check too. Splitting the powers would mean
  /// the operator could create the business owner's account but not help them
  /// when something broke.
  superadmin
}

enum UserStatus {
  /// Signed up and waiting to be approved. Agents start here.
  ///
  /// A pending agent can sign in and see that they are waiting, and can do
  /// nothing else: both places that resolve a seller already require `active`,
  /// so their shop link does not sell and no order can be attributed to them.
  /// That gate existed before this state did, which is why adding it is safe.
  pending
  active
  /// Turned down, with a reason they are shown. Distinct from `suspended`: one
  /// never traded, the other did and was stopped.
  rejected
  suspended
}

enum Category {
  data
  airtime
  voice
  sms
  afa
  checker
}

enum Network {
  MTN
  Telecel
  AirtelTigo
}

/// FR-4.4 — the only legal order states.
enum OrderStatus {
  /// Placed, but the customer has not paid yet.
  ///
  /// A state of its own rather than a flavour of `pending`, and the reason is a
  /// bug this caused: the restart-recovery sweep dispatches anything `pending`
  /// with no provider reference, so reusing `pending` for "unpaid" handed out
  /// free bundles on every reboot. Nothing sweeps this status, and nothing may:
  /// an order leaves it only when Paystack confirms the money.
  awaiting_payment
  pending
  processing
  /// Paid for, but the recipient's number is not yet approved by the provider.
  ///
  /// A real state of its own, not a flavour of `processing`: nothing is in
  /// flight at DataHub, so the reconciler must not ask them about it, and it is
  /// not `failed` because the money is still held and the bundle is still
  /// coming. It resolves when the number is approved and the order is retried,
  /// or it is refunded automatically once the hold expires.
  awaiting_approval
  completed
  failed
}

enum PaidWith {
  wallet
  momo
}

/// Movements against a customer wallet (FR-2.4).
enum TxType {
  topup
  purchase
  refund
}

/// Movements against an agent's earnings account.
enum EarningType {
  sale
  downline
  reversal
  withdrawal
}

enum WithdrawalStatus {
  pending
  /// Authorised, and the transfer has been handed to Paystack.
  ///
  /// Not the end of the story: Paystack settles asynchronously, so an approved
  /// withdrawal is money promised and in flight, not money delivered. It becomes
  /// `paid` or `failed` when they say so.
  approved
  /// Paystack confirmed the money reached the agent.
  paid
  /// The transfer was refused or reversed. The amount is returned to the agent's
  /// balance, because it never left the platform.
  failed
  rejected
}

model User {
  id           String     @id @default(uuid())
  name         String
  /// Unique per role, not globally — see the @@unique blocks at the end of this
  /// model. One person may hold more than one profile, and they share a phone
  /// and an email because they are the same person.
  phone        String
  email        String
  passwordHash String?    @map("password_hash")
  role         Role
  status       UserStatus @default(active)

  /// Why an application was turned down, in the words the applicant is shown.
  /// Also carries a suspension note.
  statusNote String?   @map("status_note")
  /// When somebody decided, and who. Null while an application is waiting.
  decidedAt  DateTime? @map("decided_at")
  decidedBy  String?   @map("decided_by")

  /// FR-1.7 — unique per user, and the handle a sell link is built from.
  referralCode String  @unique @map("referral_code")
  /// null means this agent sits directly under James (the admin root).
  uplineCode   String? @map("upline_code")

  /// Default markup over this agent's own cost, as a percentage. Applied to any
  /// product the agent has not priced explicitly.
  markupPercent Int @default(8) @map("markup_percent")

  /// Customers: spendable wallet. Agents: withdrawable earnings. One column,
  /// because a user holds exactly one role. Guarded by CHECK (balance >= 0).
  balance Int @default(0)

  joinedAt DateTime @default(now()) @map("joined_at")

  prices           AgentPrice[]
  orders           Order[]
  transactions     Transaction[]
  earnings         Earning[]
  withdrawals      Withdrawal[]
  payments         Payment[]
  branding         Branding?
  brandingRequests BrandingRequest[]
  setupTokens      SetupToken[]

  /**
   * One profile per role per person.
   *
   * James runs the business and also wants to sell as an agent, to see what his
   * agents see. Those cannot be the same row: an agent owns a balance, a referral
   * code, a downline and earnings that the platform's own margin must never be
   * mixed with. So they are separate users who happen to be the same human.
   *
   * Uniqueness moved from the column to the pair. What stops a stranger claiming
   * somebody's address is now application code — registration rejects an email
   * already present under any role, and only the account's owner can add a
   * profile to it. See the invariant in AuthService.createProfile: at most one
   * row per email carries a password, and every other row with that email was
   * created deliberately by its owner.
   */
  @@unique([email, role])
  @@unique([phone, role])
  @@index([email])
  @@index([phone])
  @@index([uplineCode])
  @@index([role])
  @@map("users")
}

/// Stands in for the DataHub GH catalogue until the real API keys arrive.
///
/// This is the provider's data, not ours: their SKU code, their price, and
/// whether they currently have the bundle. Keeping it in its own table means the
/// seam is honest — when the live keys land, this table becomes a cache of the
/// API response and nothing downstream of `supplierCode` has to change.
///
/// During acceptance testing it is also the lever that makes the failure path
/// reproducible: set `available = false` and the next order for that bundle
/// fails at the provider and refunds, exactly as a real outage would.
model SupplierProduct {
  /// The provider's own SKU. What we would send in the fulfilment call.
  code     String @id
  provider String @default("datahub-gh")

  category Category
  network  Network?
  name     String
  validity String

  /// What James pays the provider. The single source of truth for cost —
  /// `products.supplier_cost` is synced from here, never typed in by hand.
  costPrice Int @map("cost_price")

  /// How DataHub GH identifies this bundle: a network key plus a size in GB.
  ///
  /// Their API takes `{ networkKey, capacity }` rather than a SKU code, so these
  /// two columns are what an order is actually placed with. Both null means the
  /// SKU has no automated fulfilment — airtime, voice, SMS, AFA and result
  /// checkers all sit in that category, because DataHub sells data only.
  networkKey String? @map("network_key")
  /// Data size in GB, as their API expects it: "1", "2", "5".
  capacityGb String? @map("capacity_gb")

  /// False when the provider is out of stock or the SKU is withdrawn.
  available Boolean @default(true)

  updatedAt DateTime @updatedAt @map("updated_at")

  products   Product[]
  dispatches SupplierDispatch[]

  @@index([category])
  @@index([available])
  @@map("supplier_products")
}

/// Every fulfilment attempt against the provider, request and outcome.
///
/// A real integration would log the HTTP call here. The simulated one logs the
/// same shape, which is what makes acceptance testing legible: a tester says
/// "my bundle never arrived" and this table says what we asked for and what came
/// back, without anyone reading application logs.
model SupplierDispatch {
  id           String @id @default(uuid())
  orderId      String @map("order_id")
  orderRef     String @map("order_ref")
  supplierCode String @map("supplier_code")

  recipient String
  /// What we paid the provider for this dispatch, at dispatch time.
  costPrice Int    @map("cost_price")

  /// 'delivered' | 'rejected'. Free text because a real provider returns its own
  /// vocabulary and we should not lose it in a narrow enum.
  outcome String
  /// The provider's reason when it rejects. Shown to admin, never to the buyer.
  reason  String?

  /// True while fulfilment is simulated. Makes it unambiguous which rows in this
  /// table were real money and which were the stand-in.
  simulated Boolean @default(true)

  /// The provider's own order reference, returned by POST /data-purchase. The
  /// only handle we have on their side of the transaction.
  providerReference String? @map("provider_reference")
  /// Their status verbatim: INITIATED, PENDING, PROCESSING, SUCCESSFUL, FAILED,
  /// CANCELLED. Stored raw rather than mapped, so a new value of theirs shows up
  /// in the log instead of being silently coerced into ours.
  providerStatus    String? @map("provider_status")

  /// What the provider ACTUALLY debited, in pesewas, from their reply.
  ///
  /// `costPrice` above is what we believed the bundle cost; this is what it cost.
  /// They are seeded from estimates rather than a real price list, so until a
  /// live purchase proves otherwise every margin in the platform is measured
  /// from a guess. Recording both makes the guess falsifiable.
  providerCharged Int? @map("provider_charged")

  /// The provider's reply, verbatim, truncated to 2KB.
  ///
  /// `reason` above is our one-line reading of it and is lossy: "Insufficient
  /// balance" says what class of failure it was but not what they wanted or what
  /// was there. This is the column to read when an order fails and the first
  /// question is what the provider actually said.
  providerResponse String? @map("provider_response")

  attempt   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")

  supplier SupplierProduct @relation(fields: [supplierCode], references: [code])
  order    Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([outcome])
  @@map("supplier_dispatches")
}

model Product {
  id       String   @id
  category Category
  /// null for products that are not network-specific (result checkers).
  network  Network?
  name     String
  /// Short descriptor shown under the name, e.g. "Non-expiry".
  validity String

  /// Which provider SKU fulfils this product.
  supplierCode String?          @map("supplier_code")
  supplier     SupplierProduct? @relation(fields: [supplierCode], references: [code])

  /// What James pays DataHub GH / the voucher supplier. Admin-only.
  /// Synced from `supplier_products.cost_price`.
  supplierCost  Int @map("supplier_cost")
  /// What James charges agents — a top-level agent's cost floor.
  adminPrice    Int @map("admin_price")
  /// What a walk-up customer pays with no agent link (FR-3.5).
  standardPrice Int @map("standard_price")

  /// The intent behind the two prices above, in basis points over cost
  /// (1500 = 15.00%).
  ///
  /// Prices are derived from these whenever the provider's cost moves, and that
  /// is the whole reason they exist. A cost rise used to be absorbed by lifting
  /// the price to meet it — `max(price, cost)` — which kept the sale legal and
  /// silently set the margin to exactly zero, on every affected bundle, without
  /// telling anyone. Storing the markup means a cost change moves the price and
  /// leaves the margin intact.
  ///
  /// Kept in sync when a price is typed in directly: the number James enters is
  /// still the price, and the markup is re-derived from it.
  agentMarkupBp  Int @map("agent_markup_bp")
  walkupMarkupBp Int @map("walkup_markup_bp")

  active Boolean @default(true)

  prices AgentPrice[]
  orders Order[]

  @@index([category])
  @@index([network])
  @@index([supplierCode])
  @@map("products")
}

/// An agent's chosen resale price for one product (FR-3.4).
model AgentPrice {
  userId      String @map("user_id")
  productId   String @map("product_id")
  resalePrice Int    @map("resale_price")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@map("agent_prices")
}

model Order {
  id        String @id @default(uuid())
  reference String @unique

  /// Idempotency key from the client (§4.4). A retried double-click on a flaky
  /// Ghana 4G connection must not produce a second debit or a second delivery.
  idempotencyKey String? @unique @map("idempotency_key")

  productId   String   @map("product_id")
  /// Denormalised so a renamed or deleted product cannot rewrite history.
  productName String   @map("product_name")
  network     Network?
  category    Category

  recipient String

  /// What the buyer actually paid.
  salePrice Int  @map("sale_price")
  /// How that money was divided, snapshotted at purchase time. Shape matches
  /// the frontend's OrderSplit exactly.
  split     Json

  /// Referral code of the agent whose sell link was used, if any.
  soldByCode String? @map("sold_by_code")

  status   OrderStatus @default(processing)
  paidWith PaidWith    @map("paid_with")

  /// Display name of the buyer; 'Guest' for an account-less purchase (FR-4.8).
  buyer       String
  buyerPhone  String  @map("buyer_phone")
  /// Set only when a signed-in user bought. Guests have no row to point at.
  buyerUserId String? @map("buyer_user_id")

  /// Present only for result-checker orders (FR-4.7).
  voucherSerial String? @map("voucher_serial")
  voucherPin    String? @map("voucher_pin")

  /// Set when the order failed and the buyer was made whole (FR-2.7).
  refunded Boolean @default(false)

  /// DataHub GH's reference for this order, once they have accepted it.
  ///
  /// Unique because it is what an inbound webhook is matched on: two orders
  /// sharing one provider reference would make a status update ambiguous, and
  /// ambiguity here means crediting the wrong agent.
  providerReference String? @unique @map("provider_reference")

  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")

  product    Product            @relation(fields: [productId], references: [id])
  buyerUser  User?              @relation(fields: [buyerUserId], references: [id])
  dispatches SupplierDispatch[]

  /// What was paid for this order, when payment is collected up front.
  payment Payment?

  /// Money owed back on this order, once a human has authorised it.
  refundRequest RefundRequest?

  @@index([soldByCode])
  @@index([status])
  @@index([createdAt])
  @@index([buyerPhone])
  @@index([reference, buyerPhone])
  @@map("orders")
}

/// Customer wallet ledger (FR-2.4). Append-only: a correction is a new row.
model Transaction {
  id           String @id @default(uuid())
  userId       String @map("user_id")
  type         TxType
  /// Signed: negative for a purchase, positive for a top-up or refund.
  amount       Int
  balanceAfter Int    @map("balance_after")
  description  String
  reference    String

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Idempotency: one wallet movement per (user, reference, type). A replayed
  /// provider callback cannot credit twice.
  @@unique([userId, reference, type])
  @@index([userId, createdAt])
  @@map("transactions")
}

/// Agent earnings ledger. Credited by sales, debited by withdrawals.
model Earning {
  id           String      @id @default(uuid())
  userId       String      @map("user_id")
  type         EarningType
  amount       Int
  balanceAfter Int         @map("balance_after")
  description  String
  reference    String
  productName  String?     @map("product_name")
  /// 0 = their own sale; 1+ = a sale made by someone below them.
  depth        Int         @default(0)

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, reference, type])
  @@index([userId, createdAt])
  @@map("earnings")
}

model Withdrawal {
  id     String @id @default(uuid())
  userId String @map("user_id")

  /// Denormalised for the admin queue, which must still render if a user row
  /// is later suspended or renamed.
  agentName  String @map("agent_name")
  agentPhone String @map("agent_phone")

  amount      Int
  momoNetwork Network          @map("momo_network")
  status      WithdrawalStatus @default(pending)

  /// Paystack's recipient handle for this agent's Mobile Money number. Reused
  /// across payouts — creating one per withdrawal would litter their dashboard.
  recipientCode  String?   @map("recipient_code")
  /// Paystack's handle for the transfer itself, for looking a dispute up.
  transferCode   String?   @map("transfer_code")
  /// Their status verbatim: pending, success, failed, reversed, otp.
  transferStatus String?   @map("transfer_status")
  /// Why a transfer failed, in words that can be shown to the agent.
  transferNote   String?   @map("transfer_note")
  /// When Paystack confirmed the money left.
  paidAt         DateTime? @map("paid_at")

  requestedAt DateTime  @default(now()) @map("requested_at")
  decidedAt   DateTime? @map("decided_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId])
  @@map("withdrawals")
}

/// NFR-3.3 — money owed back to a Mobile Money payer whose order failed.
///
/// Reversing a MoMo collection is neither instant nor guaranteed, and a guest
/// has no wallet to credit. So the amount is held against their number and they
/// are sent a claim link. Nothing is ever silently lost.
model ClaimableCredit {
  id        String   @id @default(uuid())
  phone     String
  amount    Int
  reference String   @unique
  claimed   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([phone])
  @@map("claimable_credits")
}

/// Runtime platform switches (FR-5.5 / NFR-5.2 multi-level referral, plus the
/// demo failure toggle). A row per key so a new flag needs no migration.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

/// An MTN number a customer tried to buy for, that DataHub GH has not approved.
///
/// DataHub will not deliver to a number that is not on their beneficiary list,
/// and their `/beneficiaries` submission endpoint has been returning 502 since
/// we integrated — so the only way to get a number approved is for James to do
/// it by hand in their dashboard.
///
/// He cannot do that if he does not know who tried. Without this table a refused
/// checkout left no trace at all: the customer saw "contact support", and
/// nothing on any admin screen said a sale had just been lost or whose number to
/// go and approve. Each row is one person waiting.
model BeneficiaryRequest {
  /// The recipient number. One row per number, however many times it is tried.
  phone      String @id
  /// Which DataHub network it needs approving on — YELLO or mtn_xpress.
  networkKey String @map("network_key")

  /// How many purchases this number has cost so far. A high count is a customer
  /// trying repeatedly, and worth approving first.
  attempts    Int     @default(1)
  /// The bundle most recently attempted, for context on the admin screen.
  lastProduct String? @map("last_product")
  /// Pesewas of the most recent attempt — the value of the sale being lost.
  lastValue   Int?    @map("last_value")

  firstSeenAt DateTime  @default(now()) @map("first_seen_at")
  lastSeenAt  DateTime  @updatedAt @map("last_seen_at")
  /// Set once /verify confirms DataHub accepted it. Kept rather than deleted so
  /// the same number is not re-submitted on a later attempt.
  approvedAt  DateTime? @map("approved_at")

  @@index([approvedAt])
  @@map("beneficiary_requests")
}

enum PaymentPurpose {
  /// Paying for a specific order.
  order
  /// Adding money to a customer wallet.
  topup
}

enum PaymentStatus {
  /// Initialised with Paystack. Nobody has paid anything yet.
  pending
  /// Paystack confirmed the money arrived, and we checked the amount ourselves.
  paid
  /// Paystack said it failed, or it was abandoned and later verified as unpaid.
  failed
}

/// Money we asked a customer for, and whether it arrived.
///
/// Separate from `Order` and from `Transaction` on purpose. Both of those record
/// something that has already happened; this records an *expectation*, which is
/// the state a payment spends most of its life in and the only state a webhook
/// can be matched against.
///
/// The rule this table exists to enforce: nothing is delivered and no wallet is
/// credited until a row here says `paid`, and a row only says `paid` because
/// Paystack told our server so — either through a signed webhook or through our
/// own verify call. A browser reporting success is not evidence; it is the one
/// party in the exchange with a motive to lie.
model Payment {
  /// The reference we hand Paystack. For an order it IS the order reference, so
  /// the two are impossible to mismatch; top-ups get their own.
  reference String         @id
  purpose   PaymentPurpose
  status    PaymentStatus  @default(pending)

  /// Pesewas we asked for. Checked against what Paystack says arrived, because
  /// a partial payment must never complete an order.
  amount Int

  /// Whose payment. Null for a guest buying without an account.
  userId String? @map("user_id")
  user   User?   @relation(fields: [userId], references: [id])

  /// The order this pays for. Null for a wallet top-up.
  orderId String? @unique @map("order_id")
  order   Order?  @relation(fields: [orderId], references: [id])

  /// Where the money came from once known: mobile_money, card, bank.
  channel String?

  /// Which Mobile Money network actually carried this, read from Paystack's
  /// own `authorization.bank` — not guessed from the number. Null for a card
  /// payment, or when Paystack reported a name this platform does not
  /// recognise (see `networkFromPaystackBank`).
  network Network?

  /// What Paystack kept, in pesewas, as reported by them.
  ///
  /// Read from their verify response rather than computed from a rate we believe
  /// in: the rate varies by channel, they change it, and a hardcoded percentage
  /// would silently misstate every margin the day it moved. The same reason
  /// `supplier_dispatches.provider_charged` exists.
  ///
  /// This is James's cost, not the customer's and not the agents'. The customer
  /// paid `amount`; agents are credited their margin in full; what Paystack takes
  /// comes out of what is left, which is his. So it is deliberately NOT part of
  /// the order split — that records the sale, and the invariant
  /// `salePrice = supplierCost + Σ margins` must keep holding.
  fee Int?

  /// Their transaction id, for looking a dispute up in their dashboard.
  providerId String? @map("provider_id")

  /// The Paystack page this payment was started on.
  ///
  /// Stored so a customer who reloads checkout is handed the same link back
  /// instead of a receipt for an order they have not paid for. Paystack rejects
  /// a second initialise on the same reference, so without this the link is
  /// simply lost and the sale with it.
  authorizationUrl String? @map("authorization_url")

  /// Their reply verbatim, truncated. The provider's own words survive our
  /// reading of them — the same reason supplier_dispatches keeps one.
  providerResponse String? @map("provider_response")

  paidAt    DateTime? @map("paid_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@index([userId])
  @@map("payments")
}

enum LedgerKind {
  /// A customer paid for an order. Cash in, and revenue.
  revenue
  /// What the payment processor kept on collection.
  payment_fee
  /// What the supplier actually charged to deliver it.
  supplier_cost
  /// An agent's margin on a sale, accrued the moment it completes.
  agent_margin
  /// Historical only — nothing writes this any more. A referrer used to be
  /// paid a bonus out of James's margin on their recruit's sales; multi-level
  /// referral sharing was removed at the client's request. Kept so old rows
  /// still read correctly, not because a sale can produce one today.
  referral_bonus
  /// Money given back for an order that could not be delivered.
  refund
  /// Money sent to an agent. Settles an accrued margin — not a new cost.
  payout
  /// Reserved, not yet live: nothing currently reads a transfer fee out of
  /// Paystack's payout response, so this has never been written. If Paystack
  /// ever charges one, it belongs here — until then, do not treat "always
  /// zero" as proof no fee is being charged; it only proves none is captured.
  payout_fee
  /// A customer adding money to their wallet. Cash in, but theirs, not revenue.
  topup
  /// James adding his own money to the DataHub float. Capital, not revenue.
  capital_in
  /// James taking his own money back out of the float, or correcting an entry.
  capital_out
  /// A wrongly-credited agent margin that could not be fully clawed back
  /// because the agent had already withdrawn it. A real, permanent cost to
  /// the business — distinct from `agent_margin`, which is the cost of a
  /// margin actually earned. See `FulfilmentService.reverseAgent`.
  agent_margin_writeoff
}

/// Every movement of money, once.
///
/// The books were previously spread across three tables that each knew part of
/// the story — `orders.split` for margins, `payments.fee` for processor charges,
/// `supplier_dispatches.provider_charged` for cost — so "what did this business
/// actually make" required joining all three and getting the accrual rules right
/// by hand, every time. This is the one place that answers it.
///
/// Two properties make it trustworthy:
///
///  · **Idempotent by construction.** `idempotencyKey` is unique and derived from
///    the event, not from when it was written — `order:JDC-1:supplier_cost` can
///    only exist once. Paystack retries webhooks, the reconciler re-checks
///    orders, and a settlement can be attempted twice; none of that can
///    double-count, because the second write collides and is dropped.
///
///  · **Cash and profit are separated.** `amount` is the cash movement; a payout
///    or a top-up moves cash without being a profit or loss, so `affectsProfit`
///    marks the lines that belong in a P&L. Summing the wrong one is the classic
///    way to double-count an agent's margin — once when it is earned and again
///    when it is paid.
model LedgerEntry {
  id String @id @default(uuid())

  /// Derived from the event: `<source>:<reference>:<kind>`. Unique, so replaying
  /// any settlement path is a no-op rather than a second entry.
  idempotencyKey String @unique @map("idempotency_key")

  kind LedgerKind

  /// Signed pesewas, from the business's point of view. Positive is money in.
  amount Int

  /// Whether this line belongs in profit and loss.
  ///
  /// False for movements that settle an existing obligation or hold someone
  /// else's money — a payout against an already-accrued margin, a wallet top-up.
  /// Counting those as costs would charge the same margin twice.
  affectsProfit Boolean @default(true) @map("affects_profit")

  /// Human-readable, for the statement.
  description String

  /// What this entry is about. All optional: a top-up has no order, a supplier
  /// cost has no payment.
  orderRef     String? @map("order_ref")
  paymentRef   String? @map("payment_ref")
  withdrawalId String? @map("withdrawal_id")
  /// The agent or customer this entry concerns, when it concerns one.
  userId       String? @map("user_id")

  /// When the money actually moved, which is not always when this was written —
  /// a backfilled or reconciled entry is dated by its event.
  occurredAt DateTime @map("occurred_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([kind])
  @@index([occurredAt])
  @@index([orderRef])
  @@index([userId])
  @@map("ledger_entries")
}

enum RefundStatus {
  /// Money is owed and nobody has authorised paying it back yet.
  pending
  /// Authorised. The wallet has been credited, or a claim link issued.
  approved
  /// Refused, with a reason. No money moved.
  rejected
}

enum RefundMethod {
  /// Sent back to the number that paid, as a Mobile Money transfer.
  ///
  /// The normal case, and the only one now that wallets are closed. The payer's
  /// number is the identity — they have no account, and it is where the money
  /// came from.
  transfer
  /// Straight back into a customer wallet. Kept for accounts that predate
  /// wallets being closed.
  wallet
  /// Held against their number for them to claim.
  ///
  /// Retained only so historical rows still read. Never chosen now: nothing in
  /// the platform ever implemented claiming, so money parked here could be
  /// listed and never collected — a promise on a receipt with nothing behind it.
  claimable
}

/// Money owed back to a customer, awaiting authorisation.
///
/// Refunds used to happen automatically the moment a delivery failed. That is
/// kinder to the customer and it removes the one control that matters on an
/// outbound payment: a person deciding it is owed. The cost of not having it was
/// not hypothetical — a rule that credited every failed order handed eight
/// customers GHS 196 they had never paid, and nothing stood between that bug and
/// the money.
///
/// So a failure now records a debt and stops. The money is still owed from the
/// moment it is written, which is why `SolvencyService` counts pending requests
/// as a liability — the delay is in paying, not in owing.
model RefundRequest {
  id String @id @default(uuid())

  /// One per order. A second failure on the same order does not owe twice.
  orderId String @unique @map("order_id")
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// Denormalised so the queue still renders if the order is later archived.
  orderRef    String @map("order_ref")
  productName String @map("product_name")
  buyerName   String @map("buyer_name")
  buyerPhone  String @map("buyer_phone")

  amount Int
  method RefundMethod
  /// Why the order failed, in the words shown to the admin deciding.
  reason String

  status RefundStatus @default(pending)

  /// Null until decided. Who decided, and what they said if they refused.
  decidedAt DateTime? @map("decided_at")
  decidedBy String?   @map("decided_by")
  note      String?

  /// Which Mobile Money network to pay back on.
  ///
  /// Chosen by whoever approves, not derived from the number. Ghana's number
  /// portability means a prefix cannot tell you which network carries a line —
  /// the platform used to guess and turned real customers away for it — so the
  /// person with the order in front of them picks the rail.
  momoNetwork Network? @map("momo_network")

  /// Paystack's handles for the payout, mirroring Withdrawal.
  recipientCode  String?   @map("recipient_code")
  transferCode   String?   @map("transfer_code")
  /// Their status verbatim: pending, success, failed, reversed, otp, manual.
  transferStatus String?   @map("transfer_status")
  /// Why a transfer did not go, in words that can be shown.
  transferNote   String?   @map("transfer_note")
  /// When Paystack confirmed the money reached them.
  paidAt         DateTime? @map("paid_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([status])
  @@map("refund_requests")
}

enum BrandingStatus {
  /// Submitted by an agent, waiting for the platform owner to look at it.
  pending
  approved
  rejected
}

/// The branding a shop is currently showing.
///
/// One row per shop: `userId` null is the platform's own, and an agent's row
/// overrides it on their `/s/<code>` pages. Absent or partial rows fall back to
/// the platform's, so an agent who sets only a name keeps the default colour.
///
/// This table holds only what is **live**. An agent's proposed change lives in
/// `BrandingRequest` until it is approved, so a shop can never display something
/// nobody has looked at — which matters because this is a page that asks for
/// money, and a convincing bank logo on it is somebody else's liability.
model Branding {
  id String @id @default(uuid())

  /// Null for the platform. Unique so a shop cannot have two live brandings.
  userId String? @unique @map("user_id")
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// What the shop calls itself. Null means use the platform's name.
  shopName String? @map("shop_name")

  /// The colour as chosen, in #rrggbb. The ten-step ramp is derived from it on
  /// read rather than stored: the derivation includes a contrast correction, and
  /// storing its output would freeze today's rules into every existing shop.
  brandColor String? @map("brand_color")

  /// The colour used instead, on a dark background. Null means the shop has not
  /// chosen a separate one, and `brandColor`'s own ramp is reused for both — so
  /// nobody is forced to pick two colours to get a working dark theme.
  brandColorDark String? @map("brand_color_dark")

  /// The logo, in the database rather than on a disk or in a bucket.
  ///
  /// A shop logo is a few kilobytes, and the alternatives both cost more than
  /// they are worth here: a local directory does not survive a redeploy on most
  /// hosts, and object storage means another account and another bill for
  /// something smaller than a single product photo. Capped and type-checked on
  /// the way in.
  logoMime  String? @map("logo_mime")
  logoBytes Bytes?  @map("logo_bytes")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("branding")
}

/// An agent's proposed branding, awaiting the platform owner's decision.
///
/// Deliberately the same shape as `RefundRequest`: something is proposed, a
/// person decides, and a refusal keeps its reason. Reusing the pattern means the
/// review screen behaves the way the refund queue already does.
///
/// The reason for the queue is impersonation. An agent shop takes card and Mobile
/// Money details, so an agent who names theirs after a bank or uploads a network's
/// logo is a fraud risk carried by the platform, not by them. Nothing goes live
/// unseen.
model BrandingRequest {
  id String @id @default(uuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Denormalised so the queue still reads if the agent is later suspended.
  agentName String @map("agent_name")
  agentCode String @map("agent_code")

  shopName       String? @map("shop_name")
  brandColor     String? @map("brand_color")
  brandColorDark String? @map("brand_color_dark")
  logoMime       String? @map("logo_mime")
  logoBytes      Bytes?  @map("logo_bytes")

  status BrandingStatus @default(pending)
  /// Required on a refusal, and kept: the agent is told why, and the record
  /// survives being asked about later.
  note   String?

  createdAt DateTime  @default(now()) @map("created_at")
  decidedAt DateTime? @map("decided_at")
  decidedBy String?   @map("decided_by")

  @@index([status])
  @@index([userId])
  @@map("branding_requests")
}

enum SetupTokenPurpose {
  /// A new account choosing its first password.
  setup
  /// An existing account that has forgotten it.
  reset
}

/// A one-time link for setting a password.
///
/// The whole point is that a password is never transmitted, seeded, or known by
/// anybody but its owner. A superadmin creating an admin mints one of these and
/// hands over the link; the admin sets their own password; the token dies.
///
/// Three properties make it safe to send in a message:
///
///  · **Only the hash is stored.** A leaked database does not yield working
///    links, the same reason `passwordHash` is not a password.
///  · **Single use.** `usedAt` is set inside the same transaction that changes
///    the password, so a link that is replayed does nothing.
///  · **Short-lived.** A setup link outlives a working day; a reset link does
///    not outlive an hour.
model SetupToken {
  id String @id @default(uuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256 of the token. Never the token itself.
  tokenHash String            @unique @map("token_hash")
  purpose   SetupTokenPurpose

  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("setup_tokens")
}
