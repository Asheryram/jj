// JamesDataConsult — persistence model.
//
// Money is ALWAYS an integer number of pesewas, never a float and never
// Decimal-with-scale-2 pretending to be money. GHS 12.50 is 1250. This mirrors
// the `Pesewas` type in the frontend's data/types.ts, and it is the reason every
// amount below is `Int`.
//
// CHECK constraints that the schema language cannot express (balance >= 0,
// resale_price >= floor, the split-balances invariant) live in
// scripts/constraints.sql and are applied by `npm run setup`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  customer
  agent
  admin
}

enum UserStatus {
  active
  suspended
}

enum Category {
  data
  airtime
  voice
  sms
  afa
  checker
}

enum Network {
  MTN
  Telecel
  AirtelTigo
}

/// FR-4.4 — the only legal order states.
enum OrderStatus {
  pending
  processing
  /// Paid for, but the recipient's number is not yet approved by the provider.
  ///
  /// A real state of its own, not a flavour of `processing`: nothing is in
  /// flight at DataHub, so the reconciler must not ask them about it, and it is
  /// not `failed` because the money is still held and the bundle is still
  /// coming. It resolves when the number is approved and the order is retried,
  /// or it is refunded automatically once the hold expires.
  awaiting_approval
  completed
  failed
}

enum PaidWith {
  wallet
  momo
}

/// Movements against a customer wallet (FR-2.4).
enum TxType {
  topup
  purchase
  refund
}

/// Movements against an agent's earnings account.
enum EarningType {
  sale
  downline
  reversal
  withdrawal
}

enum WithdrawalStatus {
  pending
  approved
  rejected
}

model User {
  id           String     @id @default(uuid())
  name         String
  phone        String     @unique
  email        String     @unique
  passwordHash String?    @map("password_hash")
  role         Role
  status       UserStatus @default(active)

  /// FR-1.7 — unique per user, and the handle a sell link is built from.
  referralCode String  @unique @map("referral_code")
  /// null means this agent sits directly under James (the admin root).
  uplineCode   String? @map("upline_code")

  /// Default markup over this agent's own cost, as a percentage. Applied to any
  /// product the agent has not priced explicitly.
  markupPercent Int @default(8) @map("markup_percent")

  /// Customers: spendable wallet. Agents: withdrawable earnings. One column,
  /// because a user holds exactly one role. Guarded by CHECK (balance >= 0).
  balance Int @default(0)

  joinedAt DateTime @default(now()) @map("joined_at")

  prices       AgentPrice[]
  orders       Order[]
  transactions Transaction[]
  earnings     Earning[]
  withdrawals  Withdrawal[]

  @@index([uplineCode])
  @@index([role])
  @@map("users")
}

/// Stands in for the DataHub GH catalogue until the real API keys arrive.
///
/// This is the provider's data, not ours: their SKU code, their price, and
/// whether they currently have the bundle. Keeping it in its own table means the
/// seam is honest — when the live keys land, this table becomes a cache of the
/// API response and nothing downstream of `supplierCode` has to change.
///
/// During acceptance testing it is also the lever that makes the failure path
/// reproducible: set `available = false` and the next order for that bundle
/// fails at the provider and refunds, exactly as a real outage would.
model SupplierProduct {
  /// The provider's own SKU. What we would send in the fulfilment call.
  code     String @id
  provider String @default("datahub-gh")

  category Category
  network  Network?
  name     String
  validity String

  /// What James pays the provider. The single source of truth for cost —
  /// `products.supplier_cost` is synced from here, never typed in by hand.
  costPrice Int @map("cost_price")

  /// How DataHub GH identifies this bundle: a network key plus a size in GB.
  ///
  /// Their API takes `{ networkKey, capacity }` rather than a SKU code, so these
  /// two columns are what an order is actually placed with. Both null means the
  /// SKU has no automated fulfilment — airtime, voice, SMS, AFA and result
  /// checkers all sit in that category, because DataHub sells data only.
  networkKey String? @map("network_key")
  /// Data size in GB, as their API expects it: "1", "2", "5".
  capacityGb String? @map("capacity_gb")

  /// False when the provider is out of stock or the SKU is withdrawn.
  available Boolean @default(true)

  updatedAt DateTime @updatedAt @map("updated_at")

  products   Product[]
  dispatches SupplierDispatch[]

  @@index([category])
  @@index([available])
  @@map("supplier_products")
}

/// Every fulfilment attempt against the provider, request and outcome.
///
/// A real integration would log the HTTP call here. The simulated one logs the
/// same shape, which is what makes acceptance testing legible: a tester says
/// "my bundle never arrived" and this table says what we asked for and what came
/// back, without anyone reading application logs.
model SupplierDispatch {
  id           String @id @default(uuid())
  orderId      String @map("order_id")
  orderRef     String @map("order_ref")
  supplierCode String @map("supplier_code")

  recipient String
  /// What we paid the provider for this dispatch, at dispatch time.
  costPrice Int    @map("cost_price")

  /// 'delivered' | 'rejected'. Free text because a real provider returns its own
  /// vocabulary and we should not lose it in a narrow enum.
  outcome String
  /// The provider's reason when it rejects. Shown to admin, never to the buyer.
  reason  String?

  /// True while fulfilment is simulated. Makes it unambiguous which rows in this
  /// table were real money and which were the stand-in.
  simulated Boolean @default(true)

  /// The provider's own order reference, returned by POST /data-purchase. The
  /// only handle we have on their side of the transaction.
  providerReference String? @map("provider_reference")
  /// Their status verbatim: INITIATED, PENDING, PROCESSING, SUCCESSFUL, FAILED,
  /// CANCELLED. Stored raw rather than mapped, so a new value of theirs shows up
  /// in the log instead of being silently coerced into ours.
  providerStatus String? @map("provider_status")

  /// What the provider ACTUALLY debited, in pesewas, from their reply.
  ///
  /// `costPrice` above is what we believed the bundle cost; this is what it cost.
  /// They are seeded from estimates rather than a real price list, so until a
  /// live purchase proves otherwise every margin in the platform is measured
  /// from a guess. Recording both makes the guess falsifiable.
  providerCharged Int? @map("provider_charged")

  /// The provider's reply, verbatim, truncated to 2KB.
  ///
  /// `reason` above is our one-line reading of it and is lossy: "Insufficient
  /// balance" says what class of failure it was but not what they wanted or what
  /// was there. This is the column to read when an order fails and the first
  /// question is what the provider actually said.
  providerResponse String? @map("provider_response")

  attempt   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")

  supplier SupplierProduct @relation(fields: [supplierCode], references: [code])
  order    Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([outcome])
  @@map("supplier_dispatches")
}

model Product {
  id       String   @id
  category Category
  /// null for products that are not network-specific (result checkers).
  network  Network?
  name     String
  /// Short descriptor shown under the name, e.g. "Non-expiry".
  validity String

  /// Which provider SKU fulfils this product.
  supplierCode String?          @map("supplier_code")
  supplier     SupplierProduct? @relation(fields: [supplierCode], references: [code])

  /// What James pays DataHub GH / the voucher supplier. Admin-only.
  /// Synced from `supplier_products.cost_price`.
  supplierCost   Int @map("supplier_cost")
  /// What James charges agents — a top-level agent's cost floor.
  adminPrice     Int @map("admin_price")
  /// What a walk-up customer pays with no agent link (FR-3.5).
  standardPrice  Int @map("standard_price")

  /// The intent behind the two prices above, in basis points over cost
  /// (1500 = 15.00%).
  ///
  /// Prices are derived from these whenever the provider's cost moves, and that
  /// is the whole reason they exist. A cost rise used to be absorbed by lifting
  /// the price to meet it — `max(price, cost)` — which kept the sale legal and
  /// silently set the margin to exactly zero, on every affected bundle, without
  /// telling anyone. Storing the markup means a cost change moves the price and
  /// leaves the margin intact.
  ///
  /// Kept in sync when a price is typed in directly: the number James enters is
  /// still the price, and the markup is re-derived from it.
  agentMarkupBp  Int @map("agent_markup_bp")
  walkupMarkupBp Int @map("walkup_markup_bp")

  active Boolean @default(true)

  prices AgentPrice[]
  orders Order[]

  @@index([category])
  @@index([network])
  @@index([supplierCode])
  @@map("products")
}

/// An agent's chosen resale price for one product (FR-3.4).
model AgentPrice {
  userId      String @map("user_id")
  productId   String @map("product_id")
  resalePrice Int    @map("resale_price")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@map("agent_prices")
}

model Order {
  id        String @id @default(uuid())
  reference String @unique

  /// Idempotency key from the client (§4.4). A retried double-click on a flaky
  /// Ghana 4G connection must not produce a second debit or a second delivery.
  idempotencyKey String? @unique @map("idempotency_key")

  productId String   @map("product_id")
  /// Denormalised so a renamed or deleted product cannot rewrite history.
  productName String @map("product_name")
  network     Network?
  category    Category

  recipient String

  /// What the buyer actually paid.
  salePrice Int @map("sale_price")
  /// How that money was divided, snapshotted at purchase time. Shape matches
  /// the frontend's OrderSplit exactly.
  split     Json

  /// Referral code of the agent whose sell link was used, if any.
  soldByCode String? @map("sold_by_code")

  status   OrderStatus @default(processing)
  paidWith PaidWith    @map("paid_with")

  /// Display name of the buyer; 'Guest' for an account-less purchase (FR-4.8).
  buyer      String
  buyerPhone String  @map("buyer_phone")
  /// Set only when a signed-in user bought. Guests have no row to point at.
  buyerUserId String? @map("buyer_user_id")

  /// Present only for result-checker orders (FR-4.7).
  voucherSerial String? @map("voucher_serial")
  voucherPin    String? @map("voucher_pin")

  /// Set when the order failed and the buyer was made whole (FR-2.7).
  refunded Boolean @default(false)

  /// DataHub GH's reference for this order, once they have accepted it.
  ///
  /// Unique because it is what an inbound webhook is matched on: two orders
  /// sharing one provider reference would make a status update ambiguous, and
  /// ambiguity here means crediting the wrong agent.
  providerReference String? @unique @map("provider_reference")

  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")

  product    Product            @relation(fields: [productId], references: [id])
  buyerUser  User?              @relation(fields: [buyerUserId], references: [id])
  dispatches SupplierDispatch[]

  @@index([soldByCode])
  @@index([status])
  @@index([createdAt])
  @@index([buyerPhone])
  @@index([reference, buyerPhone])
  @@map("orders")
}

/// Customer wallet ledger (FR-2.4). Append-only: a correction is a new row.
model Transaction {
  id           String @id @default(uuid())
  userId       String @map("user_id")
  type         TxType
  /// Signed: negative for a purchase, positive for a top-up or refund.
  amount       Int
  balanceAfter Int    @map("balance_after")
  description  String
  reference    String

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Idempotency: one wallet movement per (user, reference, type). A replayed
  /// provider callback cannot credit twice.
  @@unique([userId, reference, type])
  @@index([userId, createdAt])
  @@map("transactions")
}

/// Agent earnings ledger. Credited by sales, debited by withdrawals.
model Earning {
  id           String      @id @default(uuid())
  userId       String      @map("user_id")
  type         EarningType
  amount       Int
  balanceAfter Int         @map("balance_after")
  description  String
  reference    String
  productName  String?     @map("product_name")
  /// 0 = their own sale; 1+ = a sale made by someone below them.
  depth        Int         @default(0)

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, reference, type])
  @@index([userId, createdAt])
  @@map("earnings")
}

model Withdrawal {
  id     String @id @default(uuid())
  userId String @map("user_id")

  /// Denormalised for the admin queue, which must still render if a user row
  /// is later suspended or renamed.
  agentName  String @map("agent_name")
  agentPhone String @map("agent_phone")

  amount      Int
  momoNetwork Network          @map("momo_network")
  status      WithdrawalStatus @default(pending)

  requestedAt DateTime  @default(now()) @map("requested_at")
  decidedAt   DateTime? @map("decided_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId])
  @@map("withdrawals")
}

/// NFR-3.3 — money owed back to a Mobile Money payer whose order failed.
///
/// Reversing a MoMo collection is neither instant nor guaranteed, and a guest
/// has no wallet to credit. So the amount is held against their number and they
/// are sent a claim link. Nothing is ever silently lost.
model ClaimableCredit {
  id        String   @id @default(uuid())
  phone     String
  amount    Int
  reference String   @unique
  claimed   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([phone])
  @@map("claimable_credits")
}

/// Runtime platform switches (FR-5.5 / NFR-5.2 multi-level referral, plus the
/// demo failure toggle). A row per key so a new flag needs no migration.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

/// An MTN number a customer tried to buy for, that DataHub GH has not approved.
///
/// DataHub will not deliver to a number that is not on their beneficiary list,
/// and their `/beneficiaries` submission endpoint has been returning 502 since
/// we integrated — so the only way to get a number approved is for James to do
/// it by hand in their dashboard.
///
/// He cannot do that if he does not know who tried. Without this table a refused
/// checkout left no trace at all: the customer saw "contact support", and
/// nothing on any admin screen said a sale had just been lost or whose number to
/// go and approve. Each row is one person waiting.
model BeneficiaryRequest {
  /// The recipient number. One row per number, however many times it is tried.
  phone      String  @id
  /// Which DataHub network it needs approving on — YELLO or mtn_xpress.
  networkKey String  @map("network_key")

  /// How many purchases this number has cost so far. A high count is a customer
  /// trying repeatedly, and worth approving first.
  attempts   Int     @default(1)
  /// The bundle most recently attempted, for context on the admin screen.
  lastProduct String? @map("last_product")
  /// Pesewas of the most recent attempt — the value of the sale being lost.
  lastValue   Int?    @map("last_value")

  firstSeenAt DateTime  @default(now()) @map("first_seen_at")
  lastSeenAt  DateTime  @updatedAt @map("last_seen_at")
  /// Set once /verify confirms DataHub accepted it. Kept rather than deleted so
  /// the same number is not re-submitted on a later attempt.
  approvedAt  DateTime? @map("approved_at")

  @@index([approvedAt])
  @@map("beneficiary_requests")
}
