# Files the Linux containers execute or read must keep LF line endings even when checked out on Windows
# (with CRLF a shell script fails with "exec ... no such file or directory" at container start).
*.sh text eol=lf
*.conf text eol=lf
*.sql text eol=lf
*.mjs text eol=lf
Dockerfile* text eol=lf
.infradeploy/** text eol=lf
